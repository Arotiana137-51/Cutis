# ── Secrets: never commit these ─────────────────────────────────────────────
*.p8
*.p12
*.cer
*.mobileprovision
*.keystore
.env
.env.*
!.env.example

# ── iOS ─────────────────────────────────────────────────────────────────────
# The Xcode project is generated by XcodeGen from ios-app/project.yml.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.swiftpm/
.build/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive/
ios-app/build/
ios-app/vendor/
ios-app/.bundle/
ios-app/fastlane/report.xml
ios-app/fastlane/README.md
ios-app/fastlane/test_output/

# ── Backend (Python) ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Admin web (Node) ────────────────────────────────────────────────────────
node_modules/
.next/
out/

# ── General ─────────────────────────────────────────────────────────────────
build/
*.log
.DS_Store
.idea/
*.iml
.vscode/
